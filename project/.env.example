# Server-only. Add these in the Vercel project for Production and Preview.
# Do not prefix them with VITE_. They must never be bundled into the app.
#
# 1. Create a free project at https://supabase.com
# 2. Run project/supabase/schema.sql in the Supabase SQL editor
# 3. Fill these in, then redeploy

LIFT_PASSCODE=replace-with-a-long-passcode
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
