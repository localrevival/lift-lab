# Server-only. Add these in the Vercel project for Production and Preview.
# Do not prefix them with VITE_. They must never be bundled into the app.
#
# lift lab lives in the existing Local Revival Supabase project, in schema
# lift_lab only. Run project/supabase/schema.sql in that project's SQL editor,
# replace the lift_lab_app password, then fill these in and redeploy.
#
# Transaction pooler, port 6543. The username for this role is
# lift_lab_app.<project-ref> (not postgres.<project-ref>).

LIFT_PASSCODE=replace-with-a-long-passcode
LIFT_DATABASE_URL=postgresql://lift_lab_app.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
